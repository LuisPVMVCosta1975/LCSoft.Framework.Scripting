#Include String.LCSScriptInclude

MD5Class = _
Func GetMD5Class()
{
	If(MD5Class:IsEmpty())
	{
		If(IsDebug:IfMissing(False))
		{
			MD5Class = CreateAssemblyClass("C:\\Program Files\\dotnet\\packs\\Microsoft.NETCore.App.Ref\\10.0.0\\ref\\net10.0\\System.Security.Cryptography.dll", "System.Security.Cryptography.MD5")
		}
		Else(IsRealease:IfMissing(False))
		{
			MD5Class = CreateAssemblyClass("win-x64/System.Security.Cryptography.dll", "System.Security.Cryptography.MD5")
		}
		Else()
		{
			MD5Class = CreateAssemblyClass("System.Security.Cryptography.dll", "System.Security.Cryptography.MD5")
		}
	}
	
	Return(MD5Class)
}

Func CreateMD5Generator()
{
	Return(GetMD5Class():Create())
}

Func GenerateMD5Hash(Text, MD5Generator)
{
	If(MD5Generator:IsEmpty())
	{
		MD5Generator = CreateMD5Generator()
	}
	
	Return(MD5Generator:ComputeHash(GetEncodingClass():UTF8:GetBytes(Text)))
}

