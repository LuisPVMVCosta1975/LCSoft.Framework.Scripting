Func CreateSQLiteConnection(ConnectionString)
{
	Return
	(
		CreateAssemblyObject
		(
			"Microsoft.Data.Sqlite.dll", 
			"Microsoft.Data.Sqlite.SqliteConnection", 
			ConnectionString
		)
	)
}

