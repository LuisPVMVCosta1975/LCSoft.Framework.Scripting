#Tests For GreatestLowest.LCSScriptInclude

Include Library/Native/GreatestLowest.LCSScriptInclude

#Setup

A = 1
B = 2

#Test

C1 = GetGreatest(A, B)
C2 = GetLowest(A, B)
C3 = GetGreatest(A, A)
C4 = GetLowest(A, A)

#Assert

ReturnIf(C1 <> B, "C1: " + C1)
ReturnIf(C2 <> A, "C2: " + C2)
ReturnIf(C3 <> A, "C3: " + C3)
ReturnIf(C4 <> A, "C4: " + C4)