#Tests For RangeFunctions.LCSScriptInclude

Include Library/Native/RangeFunctions.LCSScriptInclude

#Setup

A = "1234567890"

#Tests

B1 = DropStart(A, RangeSelectorEnum:Length, 2)
ReturnIf(B1 <> "34567890", "B1: " + B1) 
B2 = DropStart(A, RangeSelectorEnum:PositionExclusive, 2)
ReturnIf(B2 <> "34567890", "B2: " + B2)
B3 = DropStart(A, RangeSelectorEnum:PositionInclusive, 2)
ReturnIf(B3 <> "4567890", "B3: " + B3)

C1 = DropMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(C1 <> "", "C1: " + C1)
C2 = DropMiddle(A, RangeSelectorEnum:Length, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(C2 <> "12", "C2: " + C2)
C3 = DropMiddle(A, RangeSelectorEnum:PositionInclusive, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(C3 <> "12", "C3: " + C3)
C4 = DropMiddle(A, RangeSelectorEnum:PositionExclusive, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(C4 <> "123", "C4: " + C4)
C5 = DropMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:Length, 5)
ReturnIf(C5 <> "67890", "C5: " + C5)
C6 = DropMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:PositionInclusive, 5)
ReturnIf(C6 <> "7890", "C6: " + C6)
C7 = DropMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:PositionExclusive, 5)
ReturnIf(C7 <> "67890", "C7: " + C7)

D1 = DropEnd(A, RangeSelectorEnum:Length, 4)
ReturnIf(D1 <> "123456", "D1: " + D1)
D2 = DropEnd(A, RangeSelectorEnum:PositionExclusive, 4)
ReturnIf(D2 <> "12345", "D2: " + D2)
D3 = DropEnd(A, RangeSelectorEnum:PositionInclusive, 4)
ReturnIf(D3 <> "1234", "D3: " + D3)

E1 = TakeStart(A, RangeSelectorEnum:Length, 2)
ReturnIf(E1 <> "12", "E1: " + E1)
E2 = TakeStart(A, RangeSelectorEnum:PositionExclusive, 2)
ReturnIf(E2 <> "12", "E2: " + E2)
E3 = TakeStart(A, RangeSelectorEnum:PositionInclusive, 2)
ReturnIf(E3 <> "123", "E3: " + E3)

F1 = TakeMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(F1 <> "1234567890", "F1: " + F1)
F2 = TakeMiddle(A, RangeSelectorEnum:Length, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(F2 <> "34567890", "F2: " + F2)
F3 = TakeMiddle(A, RangeSelectorEnum:PositionInclusive, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(F3 <> "34567890", "F3: " + F3)
F4 = TakeMiddle(A, RangeSelectorEnum:PositionExclusive, 2, RangeSelectorEnum:Ignore, 5)
ReturnIf(F4 <> "4567890", "F4: " + F4)
F5 = TakeMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:Length, 5)
ReturnIf(F5 <> "12345", "F5: " + F5)
F6 = TakeMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:PositionInclusive, 5)
ReturnIf(F6 <> "123456", "F6: " + F6)
F7 = TakeMiddle(A, RangeSelectorEnum:Ignore, 2, RangeSelectorEnum:PositionExclusive, 5)
ReturnIf(F7 <> "12345", "F7: " + F7)

G1 = TakeEnd(A, RangeSelectorEnum:Length, 4)
ReturnIf(G1 <> "7890", "G1: " + G1)
G2 = TakeEnd(A, RangeSelectorEnum:PositionExclusive, 4)
ReturnIf(G2 <> "67890", "G2: " + G2)
G3 = TakeEnd(A, RangeSelectorEnum:PositionInclusive, 4)
ReturnIf(G3 <> "567890", "G3: " + G3)